# Copy to .env and fill in. Never commit real secrets.

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://lucid:lucid@localhost:5432/lucid

# AES-256-GCM key for encrypting secrets at rest (base64-encoded 32 bytes)
LUCID_ENCRYPTION_KEY=

# JWT signing secret (random string)
LUCID_JWT_SECRET=

# Optional: lock outbound traffic to a specific NIC (VPN bypass prevention)
# BIND_IFACE=eth0
# BIND_IP=192.168.1.10
